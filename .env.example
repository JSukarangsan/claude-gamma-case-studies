# Gamma API Configuration
# Get your API key from: https://gamma.app/settings/api

GAMMA_API_KEY=sk-gamma-your-api-key-here

# Gamma Template ID
# Create your own case study template in Gamma and get the template ID from the URL
# Template ID format: g_xxxxxxxxx (found in gamma.app/docs/[template-id])
GAMMA_TEMPLATE_ID=g_your-template-id-here
